#!/usr/bin/env sh

# Checking for the executable on PATH instead of "gem list foreman -i" keeps
# startup quiet: "gem list" boots RubyGems outside Bundler, which activates a
# second RDoc and floods stderr with "already initialized constant" warnings.
if ! command -v foreman >/dev/null 2>&1; then
  echo "Installing foreman..."
  gem install foreman
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev "$@"
